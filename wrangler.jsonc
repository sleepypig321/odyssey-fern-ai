{
  "name": "odyssey-fern-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "FERN_RATE",
      "namespace_id": "318847",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8"
  }
}